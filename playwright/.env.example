E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=admin123

# Optional. When set, global-teardown.ts connects directly to this database
# at the end of the run and deletes every customer (and its orders / order
# images / order status history / activity log rows) that this run created
# via POST /customers — nothing else. Use the same value as the backend's
# own DATABASE_URL (repairhub-backend/.env) for a local dev DB. If unset,
# DB cleanup is skipped and a single log line notes that. See
# scripts/db-cleanup.js and the "Database Cleanup" section in README.md.
# E2E_DATABASE_URL=postgresql://user:pass@localhost:5432/repairhub

# Optional, and normally left unset. The target above must look like a
# local/test database (loopback host, the local docker-compose Postgres
# service name, or a db name matching /test|e2e/i) or cleanup refuses to
# run and deletes nothing. Set this to "1" only if you deliberately want
# to run cleanup against a database that doesn't match those rules.
# E2E_ALLOW_REMOTE_CLEANUP=1
